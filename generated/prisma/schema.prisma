generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // provider = "sqlite"
}

model Entry {
  id      Int       @id @default(autoincrement())
  title   String
  type    EntryType
  date    DateTime?
  amount  Float?
  pdfPath String?
}

enum EntryType {
  DOCUMENT
  FORM
  RECIEPT
}
